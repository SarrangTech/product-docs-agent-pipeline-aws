# S3 bucket backing the bronze/silver/gold medallion layers. Required.
BRONZE_BUCKET=sarang-lake-bronze

# AWS region for the S3, Bedrock, and Lambda clients.
AWS_REGION=us-east-1

# GitHub repository the bronze layer ingests markdown documentation from.
GITHUB_REPO_URL=https://github.com/aws/aws-sdk-pandas.git

# Bedrock embedding model id, used for both gold-layer chunk embeddings and
# query-time embeddings in the retrieval Lambda.
BEDROCK_MODEL_ID=amazon.titan-embed-text-v2:0

# Character length of each gold-layer chunk.
CHUNK_SIZE=2000

# Character overlap between consecutive gold-layer chunks.
CHUNK_OVERLAP=200

# Python logging level: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO
